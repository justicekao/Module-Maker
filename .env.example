DATABASE_URL="postgresql://user:password@localhost:5432/modulemaker?schema=public"

# Session/JWT signing secret for Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM key used to encrypt user-supplied AI provider API keys at rest.
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=""

# Platform cut taken from paid module sales, in basis points (1500 = 15%).
PLATFORM_FEE_BPS=1500

# Stripe (test mode keys - https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MEMBERSHIP_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
